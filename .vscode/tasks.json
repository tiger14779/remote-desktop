{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Relay: run (go run ./cmd/relay)",
            "detail": "Foreground Go relay on :7100 with config.production.json. Ctrl+C in the terminal to stop.",
            "type": "shell",
            "command": "go",
            "args": [
                "run",
                "./cmd/relay",
                "-listen", ":7100",
                "-config", "deploy/config.production.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}/relay"
            },
            "isBackground": true,
            "presentation": {
                "panel": "dedicated",
                "reveal": "always",
                "clear": false,
                "echo": true,
                "showReuseMessage": false,
                "group": "runtime"
            },
            "problemMatcher": {
                "owner": "go",
                "pattern": {
                    "regexp": "^([^:]+):(\\d+):(\\d+):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*relay listening.*",
                    "endsPattern": ".*relay listening on.*"
                }
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "App: configure",
            "detail": "cmake -S app -B app/build with FFMPEG_ROOT + Qt prefix passed explicitly so the cache can't go stale on us. Idempotent.",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "app",
                "-B", "app/build",
                "-G", "Visual Studio 18 2026",
                "-A", "x64",
                "-DFFMPEG_ROOT=E:/Development_environment/vcpkg/installed/x64-windows",
                "-DCMAKE_PREFIX_PATH=E:/Development_environment/qt/6.7.3/msvc2022_64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "panel": "shared",
                "reveal": "always",
                "clear": true,
                "group": "build"
            },
            "problemMatcher": []
        },
        {
            "label": "App: build (Release)",
            "detail": "Default build (Ctrl+Shift+B). Runs configure first, then cmake --build. -- /m for parallel jobs.",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "app/build",
                "--config", "Release",
                "--", "/m", "/v:minimal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "panel": "shared",
                "reveal": "always",
                "clear": false,
                "group": "build"
            },
            "dependsOn": ["App: configure"],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "App: clean (rm -rf app/build)",
            "detail": "Wipe app/build entirely. Use when cmake's cache has gone stale (empty FFMPEG_ROOT in vcxproj POST_BUILD, etc.).",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Remove-Item app/build -Recurse -Force -ErrorAction Ignore; Write-Host 'cleaned app/build'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "panel": "shared",
                "reveal": "always",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "App: run (no rebuild)",
            "detail": "Launch app/build/Release/remote-desktop.exe. Closes when you close the window.",
            "type": "shell",
            "command": "${workspaceFolder}/app/build/Release/remote-desktop.exe",
            "options": {
                "cwd": "${workspaceFolder}/app/build/Release"
            },
            "isBackground": true,
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "showReuseMessage": false,
                "group": "runtime"
            },
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "App: build + run",
            "detail": "Compile app then launch it. The actual daily iteration step.",
            "dependsOrder": "sequence",
            "dependsOn": [
                "App: build (Release)",
                "App: run (no rebuild)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Dev: relay + app (split terminals)",
            "detail": "Start relay AND app together, each in its own VS Code terminal panel.",
            "dependsOn": [
                "Relay: run (go run ./cmd/relay)",
                "App: build + run"
            ],
            "problemMatcher": []
        }
    ]
}
